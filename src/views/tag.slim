ruby:
  images = {}
  target_tag = params[:tag]
  stack = Shellwords.escape(params[:stack].to_s)

  ps = Async { JSON `docker ps #{@calc_size} --filter label=com.docker.stack.namespace=#{stack} --format '{{.ID}}' | xargs -r docker inspect #{@calc_size_inspect} 2>&1 | jq -s` }
  sps = Async { JSON `docker stack ps #{stack} --no-trunc --format "{{json .}}" | jq -s .` }

  containers = Array(ps.wait.first).to_h { |c| [c.dig('Config', 'Labels', 'com.docker.swarm.task.id'), c] }
  tasks = sps.wait.uniq { |task| task['Name'] }
  tag_list = tasks.map { |task| tag_image_row(task, containers[task['ID']], images) }
  tag_list = tag_list.partition { |row| row[:Repository] }.flatten(1)
  columns = %i[Name Image Digests Tags Version Created]

  if request.post?
    selected = Array(params[:services])
    outputs = tag_list.filter_map do |row|
      next unless row[:Repository] && selected.include?(row[:Name])
      Async { publish_image_tag(row, target_tag) }
    end.map(&:wait)
    $container_images_cache = {}
  end

sass:
  td.skip
    opacity: 0.5
  input[type="text"]
    min-width: 20vw
  pre.error
    color: red

h1 Tag stack:  #{params[:stack]}
div target_tag: #{params[:tag]}

- if request.post?
  - outputs.each do |o|
    pre class=(o[:error] ? 'error' : '') = o[:output]

- else
  form action="" method="post"
    div
      input type="text" name="tag" value=target_tag
      input type="submit" value="Tag images"

    button type='button' onclick="document.querySelectorAll('input[type=checkbox]').forEach(c => c.checked = true)" select all
    button type='button' onclick="document.querySelectorAll('input[type=checkbox]').forEach(c => c.checked = false)" unselect all
    pre: table
      th
      - columns.each do |k|
        th = k
      - tag_list.each do |t|
        tr
          td
            - if t[:Unavailable]
              span = t[:Unavailable]
            - elsif t[:Repository]
              input type='checkbox' name='services[]' value=t[:Name] checked=t[:Tags].include?(target_tag)
          - columns.each do |c|
            td class=[c.downcase, ('skip' unless t[:Repository])] = t[c]
